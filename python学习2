3.3.py 文本关键词统计
 
python
  
# 定义需要分析的原始文本内容
text = """从容应对各种复杂局面和风险挑战。中国共产党，人民，抗疫，中国共产党人民抗疫中国共产党"""
# 定义需要统计的关键词列表
words = ["中国共产党", "人民", "抗疫"]
# 格式化输出统计表头，对齐排版
print(f"{'':<8}{'出现次数':<8}{'第一次出现位置':<12}{'最后一次出现位置'}")
# 循环遍历每一个需要统计的关键词
for w in words:
    count = text.count(w)       # 统计关键词在文本中出现总次数
    first = text.find(w)        # 获取关键词第一次出现的下标位置
    last = text.rfind(w)        # 获取关键词最后一次出现的下标位置
    # 格式化输出当前关键词的所有统计信息
    print(f"{w:<8}{count:<8}{first:<16}{last}")
 
 
4.4.py 超市收银系统
 
python
  
# 打印收银系统标题
print("Python超市收银系统")
# 接收用户输入的商品名称
product_name = input("商品名称:")
# 接收商品单价并转换为浮点型数值
price = float(input("商品单价:"))
# 接收购买数量并转换为浮点型数值
number = float(input("数量:"))
# 计算应付总金额，保留3位小数
pay_user = round(price * number, 3)
# 输出最终计算的应付金额
print("应付金额:" + str(pay_user))
# 接收顾客实际支付的金额
pay = float(input("实收:"))
# 打印购物小票标题
print("Python超市购物小票")
# 打印小票表头，使用制表符对齐
print("商品名称\t单价\t数量")
# 拼接并输出用户购买的商品信息
print(str(product_name)+"\t"+str(price)+"\t"+str(number))
# 打印本次消费应付金额
print("应付:"+ str(pay_user))
# 打印顾客实际付款金额
print("实收:" + str(pay))
# 计算找零金额并保留1位小数，输出结果
print("找零:"+str(round(pay - pay_user, 1)))
