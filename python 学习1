1.1.py 灯笼字符画
 
python
  
# 打印灯笼图案
print("    $")                # 打印灯笼顶部符号
print("  $ | $")              # 打印灯笼顶部装饰
print("----------------")     # 打印灯笼上部分分隔横线
print("(((((((((((((((((")   # 打印灯笼上侧边框
print("( | | 过年好 | | )")   # 打印灯笼中间展示文字
print("(((((((((((((((((")   # 打印灯笼下侧边框
print("----------------")     # 打印灯笼下部分分隔横线
print("    *******")          # 打印灯笼装饰星号图案
print("    $$$$$$$")          # 打印灯笼主体花纹
print("    $$$$$$$")          # 打印灯笼主体花纹
print("    ||||||||")         # 打印灯笼底部流苏
