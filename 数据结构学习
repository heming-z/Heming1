#include <stdio.h>
#define size 9//全局变量,表示数组的数组长度
//顺序输出数组元素
void PrintArray(int a[],int n){  //n 数组里面实际存储数据元素个数
	int i;

	for(i=0;i<n){
			printf("%d",a[i]);//第几个数据元素
		}
}
int main(){

	int b[size]={1,2,3,4,5,6};//声明数组b[]，并付初值
	int m = 6;//生命整型变量m,表示数组中数据元素的个数,初值为6

	PrintArray(b,m);//调用输出函数.
	
	return 0;

}
